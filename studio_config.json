{
  "blender": {
    "tested_version": "5.2.3",
    "version_guard": true
  },
  "fps": 24,
  "paths": {
    "projects_root": "projects"
  },
  "project_name": "hybrid_studio_project",
  "render": {
    "checkpoint_manifest": "render_manifest.json",
    "file_format": "PNG",
    "frame_padding": 4,
    "prefer_gpu": true
  },
  "resolution_presets": {
    "final": {
      "engine": "BLENDER_EEVEE",
      "height": 1080,
      "samples": 64,
      "width": 1920
    },
    "preview": {
      "engine": "BLENDER_EEVEE",
      "height": 180,
      "samples": 16,
      "width": 320
    },
    "production": {
      "engine": "BLENDER_EEVEE",
      "height": 540,
      "samples": 32,
      "width": 960
    }
  }
}
